# --- ComfyUI (local) ---
COMFY_URL=http://127.0.0.1:8188

# --- Pinterest (opsiyonel) ---
# Tanimliysa board pinleri resmi v5 API ile cekilir (tum pinler, sayfali).
# Bos ise board sayfasi okunarak (scrape) yalnizca ilk yuklenen pinler alinir.
# Token: developers.pinterest.com -> app olustur -> OAuth (boards:read, pins:read).
PINTEREST_ACCESS_TOKEN=

# --- Veritabani ---
DATABASE_URL="file:./dev.db"

# --- Shopify Admin API ---
# Shopify 1 Ocak 2026'dan itibaren magaza admin'inde yeni "custom app" olusturmayi
# kaldirdi. Yeni uygulamalar Dev Dashboard'da acilir ve orada shpat_ token yerine
# Client ID + Client Secret verilir; access token bunlarla client credentials grant
# ile alinir (24 saat gecerli, uygulama otomatik yeniler).
#
# Dev Dashboard -> Apps -> (uygulaman) -> Settings -> Client ID / Client secret
# Izinler (write_products, read_products, write_files, read_files) uygulamanin
# Dev Dashboard ayarlarindan verilir. Uygulama ile magaza AYNI organizasyonda olmali.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=shpss_xxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2026-07

# Elinizde eski bir admin custom app'in shpat_ token'i varsa alternatif olarak
# yalnizca bunu doldurmak yeterlidir; o zaman CLIENT_ID/SECRET gerekmez.
# SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxx

# --- Bulut (Netlify) ---
# Giris sifresi. Yerelde bos birakilirsa koruma kapali; bulutta zorunlu.
APP_PASSWORD=
# Oturum imzasi + Shopify bilgilerinin sifrelenmesi. Uzun rastgele bir metin.
# Yerelde bos birakilirsa storage/.app-secret otomatik uretilir.
APP_SECRET=
